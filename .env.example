# Slanje upita i prijava na novosti mejlom prodaji (server/utils/mail.ts).
# Lokalno: kopirati u .env. U produkciji: upisati iste promenljive u panel hostinga (build ih ne nosi sa sobom).

# Google Workspace SMTP relay: 587 + SMTP_SECURE=false (STARTTLS). Za port 465 staviti SMTP_SECURE=true.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Prazno = bez prijave: u Google Admin konzoli (SMTP relay) mora biti dozvoljena IP adresa servera.
# Sa prijavom: nalog na domenu + app password, i u Google Admin konzoli uključeno „Require SMTP Authentication“.
SMTP_USER=
SMTP_PASS=

# Od koga stiže mejl i kome stižu upiti
SMTP_FROM=info@aciko.rs
CONTACT_EMAIL=info@aciko.rs

# Neobavezno: isti upiti i prijave i na webhook (Make, Zapier, n8n…)
NUXT_INQUIRY_WEBHOOK=
NUXT_NEWSLETTER_WEBHOOK=
